<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen using the OmniTools mark. -->
    <style name="Theme.OmniTools.Starting" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/omni_navy</item>
        <item name="android:statusBarColor">@color/omni_navy</item>
        <item name="android:navigationBarColor">@color/omni_navy</item>
        <item name="android:windowSplashScreenBackground">@color/omni_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
