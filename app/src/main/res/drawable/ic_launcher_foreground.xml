<?xml version="1.0" encoding="utf-8"?>
<!-- Original OmniTools mark: a hexagonal "hub" ring with a QR-style finder square at its core. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hexagon ring -->
    <path
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M54,24 L80,39 L80,69 L54,84 L28,69 L28,39 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="24"
                android:endX="80"
                android:endY="84"
                android:type="linear">
                <item android:color="#FF4F8CFF" android:offset="0.0" />
                <item android:color="#FF8B6CFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Finder square (outer) -->
    <path
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFFFF"
        android:pathData="M43,43 L65,43 L65,65 L43,65 Z" />

    <!-- Finder square (inner dot) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50,50 L58,50 L58,58 L50,58 Z" />

    <!-- Tool nodes on the hexagon corners -->
    <path
        android:fillColor="#FF4F8CFF"
        android:pathData="M54,19.5 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
    <path
        android:fillColor="#FF8B6CFF"
        android:pathData="M54,88.5 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
</vector>
